<!--
  Main window: dashboard (three modes + system status) and the recover view. No text lives here: every element
  with Tag="i18n:<key>" gets its Text/Content/Header from i18n\<culture>.psd1 (Update-KitGuiText), so German
  and English stay in one place and a missing key shows up as [[Key]] in the tests.
  Logic lives in the engine modules; gui\RetroCabinetKit.Gui.psm1 only maps results to this view.
-->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fried's Retrogaming Kit" Width="1120" Height="760" MinWidth="880" MinHeight="620"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource NightBrush}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <Grid Margin="36,26,36,22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- header: brand mark + wordmark, language, back -->
    <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,22">
      <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
        <Image Source="{StaticResource BrandMark}" Width="48" Height="48" Margin="0,0,14,0" RenderOptions.BitmapScalingMode="HighQuality"/>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="Fried's" Style="{StaticResource Wordmark}"/>
          <TextBlock x:Name="Tagline" Tag="i18n:Gui.Tagline" Style="{StaticResource Tagline}" Margin="1,-2,0,0"/>
        </StackPanel>
      </StackPanel>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
        <Button x:Name="BackButton" Tag="i18n:Gui.Back" Style="{StaticResource SecondaryButton}" Margin="0,0,12,0" Visibility="Collapsed"/>
        <ComboBox x:Name="LanguageBox" Width="86" VerticalAlignment="Center"/>
      </StackPanel>
    </DockPanel>

    <!-- dashboard -->
    <Grid x:Name="DashboardView" Grid.Row="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <DockPanel Grid.Row="0" Margin="0,0,0,22">
        <Image DockPanel.Dock="Right" x:Name="Mascot" Width="132" Height="132" Margin="24,-12,6,0" VerticalAlignment="Top"/>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Tag="i18n:Gui.Hero.Kicker" Style="{StaticResource Kicker}" Margin="0,0,0,6"/>
          <TextBlock Tag="i18n:Gui.Hero.Title" Style="{StaticResource Headline}" FontSize="32"/>
          <TextBlock Tag="i18n:Gui.Hero.Text" Style="{StaticResource Body}" Margin="0,8,0,0" MaxWidth="640" HorizontalAlignment="Left"/>
        </StackPanel>
      </DockPanel>

      <UniformGrid Grid.Row="1" Columns="3" Margin="-8,0,-8,20">
        <Border Style="{StaticResource Card}" Margin="8,0">
          <DockPanel>
            <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
              <Button x:Name="NewPinballButton" Tag="i18n:Gui.New.Pinball" Style="{StaticResource PrimaryButton}" Margin="0,0,0,8"/>
              <Button x:Name="NewLightgunButton" Tag="i18n:Gui.New.Lightgun" Style="{StaticResource PrimaryButton}"/>
            </StackPanel>
            <StackPanel>
              <TextBlock Text="01" Style="{StaticResource Kicker}"/>
              <TextBlock Tag="i18n:Gui.New.Title" Style="{StaticResource Headline}" Margin="0,4,0,8"/>
              <TextBlock Tag="i18n:Gui.New.Text" Style="{StaticResource Body}"/>
            </StackPanel>
          </DockPanel>
        </Border>
        <Border Style="{StaticResource Card}" Margin="8,0">
          <DockPanel>
            <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
              <Button x:Name="MigrateButton" Tag="i18n:Gui.Migrate.Button" Style="{StaticResource SecondaryButton}" IsEnabled="False"/>
            </StackPanel>
            <StackPanel>
              <TextBlock Text="02" Style="{StaticResource Kicker}"/>
              <TextBlock Tag="i18n:Gui.Migrate.Title" Style="{StaticResource Headline}" Margin="0,4,0,8"/>
              <TextBlock Tag="i18n:Gui.Migrate.Text" Style="{StaticResource Body}"/>
            </StackPanel>
          </DockPanel>
        </Border>
        <Border Style="{StaticResource Card}" Margin="8,0">
          <DockPanel>
            <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
              <Button x:Name="RecoverButton" Tag="i18n:Gui.Recover.Button" Style="{StaticResource SecondaryButton}"/>
            </StackPanel>
            <StackPanel>
              <TextBlock Text="03" Style="{StaticResource Kicker}"/>
              <TextBlock Tag="i18n:Gui.Recover.Title" Style="{StaticResource Headline}" Margin="0,4,0,8"/>
              <TextBlock Tag="i18n:Gui.Recover.Text" Style="{StaticResource Body}"/>
            </StackPanel>
          </DockPanel>
        </Border>
      </UniformGrid>

      <!-- system status (doctor, read-only) -->
      <Border Grid.Row="2" Style="{StaticResource Card}" Background="{StaticResource ScreenBrush}">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <Button DockPanel.Dock="Right" x:Name="DoctorButton" Tag="i18n:Gui.Status.Recheck" Style="{StaticResource SecondaryButton}" Padding="12,6"/>
            <Button DockPanel.Dock="Right" x:Name="DetailsButton" Tag="i18n:Gui.Status.Details" Style="{StaticResource SecondaryButton}" Padding="12,6" Margin="0,0,8,0"/>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Path x:Name="StatusCrown" Data="{StaticResource CrownGeometry}" Fill="{StaticResource CrownGoldBrush}" Width="20" Height="10" Stretch="Uniform" Margin="0,0,10,0" Visibility="Collapsed"/>
              <TextBlock Tag="i18n:Gui.Status.Title" Style="{StaticResource Headline}" FontSize="18"/>
              <TextBlock x:Name="StatusSummary" Style="{StaticResource Body}" VerticalAlignment="Bottom" Margin="14,0,0,2"/>
            </StackPanel>
          </DockPanel>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <ItemsControl x:Name="StatusRows">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="0,2">
                      <TextBlock Text="{Binding Symbol}" Foreground="{Binding Brush}" FontFamily="{StaticResource MonoFont}" FontSize="12" Width="22"/>
                      <TextBlock Text="{Binding Area}" Foreground="{StaticResource CreamBrush}" FontFamily="{StaticResource MonoFont}" FontSize="12" Width="130"/>
                      <TextBlock Text="{Binding Text}" Style="{StaticResource Terminal}"/>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock x:Name="StatusDetails" Style="{StaticResource Terminal}" Margin="0,12,0,0" Visibility="Collapsed"/>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>

    <!-- recover: the kit's backups (engine: Get-KitBackup, Test-KitBackup, Restore-KitFileBackup, ...) -->
    <Grid x:Name="RecoverView" Grid.Row="1" Visibility="Collapsed">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="140"/>
      </Grid.RowDefinitions>
      <StackPanel Grid.Row="0" Margin="0,0,0,16">
        <TextBlock Tag="i18n:Gui.Recover.Kicker" Style="{StaticResource Kicker}" Margin="0,0,0,6"/>
        <TextBlock Tag="i18n:Gui.Recover.Title" Style="{StaticResource Headline}" FontSize="28"/>
        <TextBlock Tag="i18n:Gui.Recover.Steps" Style="{StaticResource Body}" Margin="0,6,0,0"/>
      </StackPanel>
      <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
        <ListView x:Name="BackupList" Background="Transparent" BorderThickness="0" Foreground="{StaticResource CreamBrush}"
                  FontFamily="{StaticResource MonoFont}" FontSize="12" SelectionMode="Single">
          <ListView.View>
            <GridView>
              <GridViewColumn Width="140" DisplayMemberBinding="{Binding CreatedText}"/>
              <GridViewColumn Width="60" DisplayMemberBinding="{Binding Kind}"/>
              <GridViewColumn Width="150" DisplayMemberBinding="{Binding Purpose}"/>
              <GridViewColumn Width="560" DisplayMemberBinding="{Binding TargetText}"/>
            </GridView>
          </ListView.View>
        </ListView>
      </Border>
      <DockPanel Grid.Row="2" Margin="0,14,0,12" LastChildFill="False">
        <CheckBox DockPanel.Dock="Left" x:Name="DryRunBox" Tag="i18n:Ui.DryRun" IsChecked="True" Foreground="{StaticResource CreamBrush}" VerticalAlignment="Center" Margin="0,0,18,0"/>
        <Button DockPanel.Dock="Left" x:Name="RefreshBackupsButton" Tag="i18n:Ui.Care.ListBackups" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
        <Button DockPanel.Dock="Left" x:Name="CheckBackupButton" Tag="i18n:Ui.Care.Check" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
        <Button DockPanel.Dock="Left" x:Name="ExportBackupButton" Tag="i18n:Ui.Care.Export" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
        <Button DockPanel.Dock="Left" x:Name="DeleteBackupButton" Tag="i18n:Ui.Care.Delete" Style="{StaticResource SecondaryButton}"/>
        <Button DockPanel.Dock="Right" x:Name="RestoreBackupButton" Tag="i18n:Ui.Care.Restore" Style="{StaticResource PrimaryButton}"/>
      </DockPanel>
      <Border Grid.Row="3" Style="{StaticResource Card}" Background="{StaticResource ScreenBrush}" Padding="16,12">
        <ScrollViewer x:Name="RecoverLogScroll" VerticalScrollBarVisibility="Auto">
          <TextBlock x:Name="RecoverLog" Style="{StaticResource Terminal}"/>
        </ScrollViewer>
      </Border>
    </Grid>

    <!-- footer -->
    <DockPanel Grid.Row="2" Margin="0,16,0,0">
      <TextBlock DockPanel.Dock="Right" Tag="i18n:Gui.Footer.Claim" Style="{StaticResource Tagline}" FontFamily="{StaticResource DisplayFont}" FontStyle="Italic"/>
      <TextBlock x:Name="FooterVersion" Style="{StaticResource Tagline}"/>
    </DockPanel>
  </Grid>
</Window>
