<!--
  Brand theme of Fried's Retrogaming Kit (design.md): Night + Cream as the base, Pixel Green for status and
  success, Retro Red for errors and the main action, Crown Gold for special hints. 70-80 % neutral, accents
  sparingly, no RGB rainbow. Dark mode is the default for the desktop app (design.md, section 10).
  Fonts: Playfair Display / Inter when installed, otherwise the closest Windows fonts (Georgia / Segoe UI).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- colors -->
  <Color x:Key="NightColor">#0E1B23</Color>
  <Color x:Key="NightRaisedColor">#14283A</Color>
  <Color x:Key="NightLineColor">#22394C</Color>
  <Color x:Key="ScreenColor">#081019</Color>
  <Color x:Key="CreamColor">#F6F2E9</Color>
  <Color x:Key="CreamMutedColor">#B9B4A8</Color>
  <Color x:Key="PixelGreenColor">#3DDC84</Color>
  <Color x:Key="RetroRedColor">#FF4B3A</Color>
  <Color x:Key="CrownGoldColor">#FFC857</Color>

  <SolidColorBrush x:Key="NightBrush" Color="{StaticResource NightColor}"/>
  <SolidColorBrush x:Key="NightRaisedBrush" Color="{StaticResource NightRaisedColor}"/>
  <SolidColorBrush x:Key="NightLineBrush" Color="{StaticResource NightLineColor}"/>
  <SolidColorBrush x:Key="ScreenBrush" Color="{StaticResource ScreenColor}"/>
  <SolidColorBrush x:Key="CreamBrush" Color="{StaticResource CreamColor}"/>
  <SolidColorBrush x:Key="CreamMutedBrush" Color="{StaticResource CreamMutedColor}"/>
  <SolidColorBrush x:Key="PixelGreenBrush" Color="{StaticResource PixelGreenColor}"/>
  <SolidColorBrush x:Key="RetroRedBrush" Color="{StaticResource RetroRedColor}"/>
  <SolidColorBrush x:Key="CrownGoldBrush" Color="{StaticResource CrownGoldColor}"/>

  <!-- fonts -->
  <FontFamily x:Key="DisplayFont">Playfair Display, Georgia, Cambria, serif</FontFamily>
  <FontFamily x:Key="UiFont">Inter, Segoe UI, Arial</FontFamily>
  <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Courier New</FontFamily>

  <!-- brand mark (the website favicon): crown, CRT, pixel face; works from 16 px up -->
  <DrawingImage x:Key="BrandMark">
    <DrawingImage.Drawing>
      <DrawingGroup>
        <GeometryDrawing Brush="{StaticResource NightBrush}" Geometry="M14,0 H50 A14,14 0 0 1 64,14 V50 A14,14 0 0 1 50,64 H14 A14,14 0 0 1 0,50 V14 A14,14 0 0 1 14,0 Z"/>
        <GeometryDrawing Brush="{StaticResource CrownGoldBrush}" Geometry="M22,14 L27,4 L32,11 L37,4 L42,14 Z"/>
        <GeometryDrawing Brush="{StaticResource CreamBrush}" Geometry="M20,16 H44 A8,8 0 0 1 52,24 V42 A8,8 0 0 1 44,50 H20 A8,8 0 0 1 12,42 V24 A8,8 0 0 1 20,16 Z"/>
        <GeometryDrawing Brush="{StaticResource ScreenBrush}" Geometry="M22,21 H42 A5,5 0 0 1 47,26 V40 A5,5 0 0 1 42,45 H22 A5,5 0 0 1 17,40 V26 A5,5 0 0 1 22,21 Z"/>
        <GeometryDrawing Brush="{StaticResource PixelGreenBrush}" Geometry="M23,26 H28 V35 H23 Z M36,26 H41 V35 H36 Z M25,38 H29 V42 H25 Z M35,38 H39 V42 H35 Z M28,40 H36 V44 H28 Z"/>
      </DrawingGroup>
    </DrawingImage.Drawing>
  </DrawingImage>

  <!-- the crown alone: brand signature, used sparingly (status "everything healthy") -->
  <Geometry x:Key="CrownGeometry">M0,10 L5,0 L10,7 L15,0 L20,10 Z</Geometry>

  <!-- text -->
  <Style x:Key="Wordmark" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
    <Setter Property="FontSize" Value="30"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="Foreground" Value="{StaticResource CreamBrush}"/>
  </Style>
  <Style x:Key="Tagline" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Foreground" Value="{StaticResource CreamMutedBrush}"/>
  </Style>
  <Style x:Key="Headline" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
    <Setter Property="FontSize" Value="22"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{StaticResource CreamBrush}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <Style x:Key="Body" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="LineHeight" Value="19"/>
    <Setter Property="Foreground" Value="{StaticResource CreamMutedBrush}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <Style x:Key="Kicker" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="Foreground" Value="{StaticResource PixelGreenBrush}"/>
  </Style>
  <Style x:Key="Terminal" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="LineHeight" Value="18"/>
    <Setter Property="Foreground" Value="{StaticResource CreamMutedBrush}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>

  <!-- cards -->
  <Style x:Key="Card" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource NightRaisedBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource NightLineBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="12"/>
    <Setter Property="Padding" Value="22"/>
  </Style>

  <!-- buttons: primary = Retro Red (the one main action), secondary = outline -->
  <Style x:Key="PrimaryButton" TargetType="Button">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{StaticResource NightBrush}"/>
    <Setter Property="Background" Value="{StaticResource RetroRedBrush}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Padding" Value="16,9"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Frame" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Opacity" Value="0.88"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource CrownGoldBrush}"/><Setter TargetName="Frame" Property="BorderThickness" Value="2"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="0.35"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
    <Setter Property="Foreground" Value="{StaticResource CreamBrush}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{StaticResource NightLineBrush}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource CreamMutedBrush}"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource CrownGoldBrush}"/><Setter TargetName="Frame" Property="BorderThickness" Value="2"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="0.35"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
